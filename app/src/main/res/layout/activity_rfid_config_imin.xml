<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ═══════════════ HEADER ═══════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1B5E20"
            android:padding="16dp"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📡 RFID iMin Lark 1"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SDK v1.0.3  |  I24P01  |  UHF RFID"
                android:textSize="12sp"
                android:textColor="#A5D6A7"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- ═══════════════ ESTADO DEL SERVICIO ═══════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_imin_service_status"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="com.imin.peripherservice: ?"
                android:textSize="12sp"
                android:textColor="#444444"/>

            <Button
                android:id="@+id/btn_imin_check_service"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verificar"
                android:backgroundTint="#558B2F"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- ═══════════════ ESTADO DE CONEXIÓN ═══════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_imin_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● DESCONECTADO"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#D32F2F"/>

                <TextView
                    android:id="@+id/tv_imin_device_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dispositivo: --"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btn_imin_diagnostic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 Info"
                android:backgroundTint="#455A64"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════
             SECCIÓN PRINCIPAL — PRUEBA DIRECTA SDK (SIN PATRÓN)
             ═══════════════════════════════════════════════════════════ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PRUEBA DIRECTA — SDK iMin"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#E65100"
            android:padding="10dp"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Llama directamente a RFIDManager sin patrón de abstracción"
            android:textSize="11sp"
            android:textColor="#BF360C"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <!-- FILA 1: CONECTAR / DESCONECTAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_direct_connect"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:text="🔗 CONECTAR"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btn_direct_disconnect"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:text="❌ DESCONECTAR"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#B71C1C"
                android:textColor="#FFFFFF"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- FILA 2: LECTURA SENCILLA -->
        <Button
            android:id="@+id/btn_direct_single"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="📖 LECTURA SENCILLA (1 Tag, auto-stop)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <!-- FILA 3: START / STOP MÚLTIPLE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_direct_start"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:text="▶ START\n(Múltiple)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#F57F17"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btn_direct_stop"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:text="⏹ STOP\n(Múltiple)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#37474F"
                android:textColor="#FFFFFF"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- ═══════════════ TAGS LEÍDOS ═══════════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tags Leídos:"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tv_imin_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:background="#E8F5E9"
            android:padding="12dp"
            android:text="Esperando lectura..."
            android:textColor="#1B5E20"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <!-- ═══════════════ SEPARADOR ═══════════════ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>

        <!-- ═══════════════════════════════════════════════════════════
             SECCIÓN SECUNDARIA — CON PATRÓN (ReaderFactory/IReaderDevice)
             ═══════════════════════════════════════════════════════════ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PRUEBA CON PATRÓN (ReaderFactory)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#4A148C"
            android:padding="10dp"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <!-- Connect/Disconnect via abstracción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_imin_connect"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Conectar"
                android:backgroundTint="#6A1B9A"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btn_imin_disconnect"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Desconectar"
                android:backgroundTint="#880E4F"
                android:textColor="#FFFFFF"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- Inventory Controls via abstracción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_imin_single"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Lectura Sencilla"
                android:backgroundTint="#6A1B9A"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btn_imin_multi"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Lectura Múltiple"
                android:backgroundTint="#6A1B9A"
                android:textColor="#FFFFFF"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btn_imin_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop Múltiple"
            android:backgroundTint="#4A148C"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp"/>

        <!-- Potencia Antena -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Potencia Antena (5–33 dBm):"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <SeekBar
            android:id="@+id/sb_imin_power"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="28"
            android:progress="25"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="5 dBm"/>

            <TextView
                android:id="@+id/tv_imin_power_label"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="30 dBm"
                android:gravity="center"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="33 dBm"
                android:gravity="end"/>
        </LinearLayout>

        <Button
            android:id="@+id/btn_imin_set_power"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aplicar Potencia"
            android:backgroundTint="#4A148C"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

        <!-- ═══════════════ LOG ═══════════════ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log de eventos:"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tv_imin_log"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:text="--- Inicio de sesión ---"
            android:background="#263238"
            android:padding="10dp"
            android:textSize="11sp"
            android:textColor="#A5D6A7"
            android:fontFamily="monospace"
            android:scrollbars="vertical"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>
