<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Validación de Conexión RFID"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"/>

        <TextView
            android:id="@+id/tv_status_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estado de Conexión:"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/tv_connection_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Desconectado"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FF0000"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tv_device_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dispositivo: --"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lector: Zebra"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de Transporte:"
            android:textSize="16sp"
            android:layout_marginBottom="4dp"/>

        <RadioGroup
            android:id="@+id/rg_transport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/rb_bluetooth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bluetooth"
                android:checked="true"
                android:layout_marginEnd="8dp"/>

            <RadioButton
                android:id="@+id/rb_usb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USB"
                android:layout_marginHorizontal="8dp"/>

            <RadioButton
                android:id="@+id/rb_serial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Serial"
                android:layout_marginStart="8dp"/>
        </RadioGroup>

        <Button
            android:id="@+id/btn_reconnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reconectar / Validar"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_test_single"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lectura Sencilla"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btn_test_multi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lectura Múltiple"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Diagnóstico avanzado exclusivo Zebra -->
        <Button
            android:id="@+id/btn_rfid_diagnostic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍  Diagnóstico Zebra"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dispositivos Encontrados:"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tv_found_devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:background="#E0F7FA"
            android:padding="8dp"
            android:text="Buscando..."
            android:textColor="#000000"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:text="Logs del sistema..."
            android:background="#EEEEEE"
            android:padding="8dp"
            android:scrollbars="vertical"/>

    </LinearLayout>
</ScrollView>
