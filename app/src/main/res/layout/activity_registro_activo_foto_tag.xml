<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fotos del Activo"
            android:fontFamily="@font/publicsansbold"
            android:textColor="#606060"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="5"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center" >

                <ImageView
                    android:id="@+id/imgFoto1"
                    android:layout_width="80dp"
                    android:layout_height="56dp"
                    android:background="#E0E0E0"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto 1"
                    android:layout_gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/imgFoto2"
                    android:layout_width="80dp"
                    android:layout_height="56dp"
                    android:background="#E0E0E0"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto 2"
                    android:layout_gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/imgFoto3"
                    android:layout_width="80dp"
                    android:layout_height="56dp"
                    android:background="#E0E0E0"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto 3"
                    android:layout_gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/imgFoto4"
                    android:layout_width="80dp"
                    android:layout_height="56dp"
                    android:background="#E0E0E0"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto 4"
                    android:layout_gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/imgFoto5"
                    android:layout_width="80dp"
                    android:layout_height="56dp"
                    android:background="#E0E0E0"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto 5"
                    android:layout_gravity="center" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ubicación Secundaria*"
            android:fontFamily="@font/publicsansbold"
            android:textColor="#606060"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundMode="outline"
            app:hintEnabled="false">

            <AutoCompleteTextView
                android:id="@+id/spUbicacionSecundaria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:dropDownHeight="wrap_content"
                android:dropDownHorizontalOffset="0dp"
                android:dropDownVerticalOffset="8dp"
                android:gravity="center_vertical"
                android:fontFamily="@font/publicsansbold"
                android:inputType="none"
                android:paddingHorizontal="8dp"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="#606060"
                android:textColorHint="#898989"
                android:background="#DDD"
                android:hint="Seleccione un elemento" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Asignar Tag RFID"
            android:fontFamily="@font/publicsansbold"
            android:textColor="#606060"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundMode="outline"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRfidTag"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="text"
                android:paddingHorizontal="10dp"
                android:textColor="#000000"
                android:backgroundTint="#FFF"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/btn_primary"
            android:text="Guardar"
            android:textColor="@android:color/background_light"
            android:textStyle="bold"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
