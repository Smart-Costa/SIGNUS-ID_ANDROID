<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/blanco"
    tools:context=".UI.activo.RegistroActivoUbicacionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registre la Ubicación"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#606060"
            android:layout_marginBottom="8dp" />

        <!-- Campo 1 - Ubicación A -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ubicación A"
            android:textColor="#606060"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:boxBackgroundMode="outline"
            app:hintEnabled="false">

            <AutoCompleteTextView
                android:id="@+id/spUbicacionA"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:dropDownHeight="wrap_content"
                android:dropDownHorizontalOffset="0dp"
                android:dropDownVerticalOffset="8dp"
                android:gravity="center_vertical"
                android:inputType="none"
                android:padding="8dp"
                android:singleLine="true"
                android:textColor="#606060"
                android:textColorHint="#898989"
                android:background="#DDD"
                android:hint="Seleccione un elemento" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo 2 - Ubicación B -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ubicación B"
            android:textColor="#606060"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:boxBackgroundMode="outline"
            app:hintEnabled="false">

            <AutoCompleteTextView
                android:id="@+id/spUbicacionB"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:dropDownHeight="wrap_content"
                android:dropDownHorizontalOffset="0dp"
                android:dropDownVerticalOffset="8dp"
                android:gravity="center_vertical"
                android:inputType="none"
                android:padding="8dp"
                android:singleLine="true"
                android:textColor="#606060"
                android:textColorHint="#898989"
                android:background="#DDD"
                android:hint="Seleccione un elemento" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo 3 - Ubicación C -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ubicación C"
            android:textColor="#606060"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:boxBackgroundMode="outline"
            app:hintEnabled="false">

            <AutoCompleteTextView
                android:id="@+id/spUbicacionC"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:dropDownHeight="wrap_content"
                android:dropDownHorizontalOffset="0dp"
                android:dropDownVerticalOffset="8dp"
                android:gravity="center_vertical"
                android:inputType="none"
                android:padding="8dp"
                android:singleLine="true"
                android:textColor="#606060"
                android:textColorHint="#898989"
                android:background="#DDD"
                android:hint="Seleccione un elemento" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo 4 - Ubicación D -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ubicación D"
            android:textColor="#606060"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:boxBackgroundMode="outline"
            app:hintEnabled="false">

            <AutoCompleteTextView
                android:id="@+id/spUbicacionD"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:dropDownHeight="wrap_content"
                android:dropDownHorizontalOffset="0dp"
                android:dropDownVerticalOffset="8dp"
                android:gravity="center_vertical"
                android:inputType="none"
                android:padding="8dp"
                android:singleLine="true"
                android:textColor="#606060"
                android:textColorHint="#898989"
                android:background="#DDD"
                android:hint="Seleccione un elemento" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botón Guardar -->
        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/btn_primary"
            android:text="Continuar"
            android:textColor="@android:color/background_light"
            android:textStyle="bold"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
