<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center"
        tools:context=".UI.config.LimpiarBaseDatosActivity">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@android:drawable/ic_dialog_alert"
            app:tint="#D32F2F"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡ADVERTENCIA!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Esta acción eliminará TODOS los datos almacenados localmente en el dispositivo (Activos, Inventarios, Configuraciones). \n\nAsegúrese de haber sincronizado cualquier cambio pendiente antes de continuar."
            android:textSize="16sp"
            android:textAlignment="center"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btnLimpiarBD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LIMPIAR BASE DE DATOS"
            android:backgroundTint="#D32F2F"
            android:textColor="@android:color/white"
            android:padding="16dp"/>

    </LinearLayout>
</ScrollView>