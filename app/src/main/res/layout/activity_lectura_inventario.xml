<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clLecturaInventario"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="Inventory.Lectura_Inventario">

    <LinearLayout
        android:id="@+id/LecturaInventario"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hacer Inventario"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <!-- Tabs for Sub-Tomas -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="16dp">
        
        <RadioGroup
            android:id="@+id/tabGroupTomas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <!-- Dynamically populated RadioButtons -->
        </RadioGroup>
    </HorizontalScrollView>

    <!-- Toggle Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        
        <Button
            android:id="@+id/btnResumen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Resumen"
            android:backgroundTint="#FF5722"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>
            
        <Button
            android:id="@+id/btnActivos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Activos"
            android:backgroundTint="#E0E0E0"
            android:textColor="#000000"/>
    </LinearLayout>

    <!-- Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Resumen View -->
        <ScrollView
            android:id="@+id/viewResumen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Gauge -->
                <RelativeLayout
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_margin="24dp">
                    
                    <ProgressBar
                        android:id="@+id/gaugeProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="false"
                        android:progressDrawable="@drawable/circular_progress_bar"
                        android:progress="0"
                        android:max="100"/>
                        
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:orientation="vertical"
                        android:gravity="center">
                        
                        <TextView
                            android:id="@+id/txtGaugeCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:textColor="#000000"/>
                            
                        <TextView
                            android:id="@+id/txtGaugeTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="De 5"
                            android:textSize="18sp"
                            android:textColor="#555555"/>
                    </LinearLayout>
                </RelativeLayout>

                <!-- Botón Simular Lectura -->
                <Button
                    android:id="@+id/btnAgregarManual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Simular Lectura (Test)"
                    android:backgroundTint="#673AB7"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="24dp"
                    android:layout_marginHorizontal="24dp"
                    android:visibility="visible"/>

                <!-- Status Navigation Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/btnVerEncontrados"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Encontrados\n0"
                        android:backgroundTint="#4CAF50"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:lines="2"
                        android:layout_marginEnd="4dp"/>

                    <Button
                        android:id="@+id/btnVerFaltantes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Faltantes\n0"
                        android:backgroundTint="#F44336"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:lines="2"
                        android:layout_marginEnd="4dp"/>

                    <Button
                        android:id="@+id/btnVerSobrantes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sobrantes\n0"
                        android:backgroundTint="#FFC107"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:lines="2"/>
                </LinearLayout>

                <!-- Separator -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#CCCCCC"
                    android:layout_marginVertical="16dp"/>

                <!-- Filters (Moved to Bottom) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">
                    
                    <TextView android:text="Ubicación A" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <Spinner android:id="@+id/spinnerUbicacionA" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
                    
                    <TextView android:text="Ubicación B" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <Spinner android:id="@+id/spinnerUbicacionB" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
                    
                    <TextView android:text="Ubicación C" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <Spinner android:id="@+id/spinnerUbicacionC" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
                    
                    <TextView android:text="Ubicación D" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <Spinner android:id="@+id/spinnerUbicacionD" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
                    
                    <TextView android:text="Ubicación Secundaria" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <Spinner android:id="@+id/spinnerUbicacionSecundaria" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Activos View (Previous Layout Content) -->
        <LinearLayout
            android:id="@+id/viewActivos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">
            
            <!-- Existing RFID Controls -->
             <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center">
                    <Switch
                        android:id="@+id/swRfid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:showText="true"
                        android:text="RFID"
                        android:textOff="Off"
                        android:textOn="On"/>

                    <EditText
                        android:id="@+id/txt_barcode"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="textPersonName"
                        android:windowSoftInputMode="stateHidden" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btn_GuardarToma"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Guardar Resultado"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="#FFFFFF"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/EncabezadoEncontrados"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/verde"
                    android:text="Encontrado"
                    android:textColor="#FFFFFF"
                    android:padding="4dp"/>

                <EditText
                    android:id="@+id/txtEncontrados"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:inputType="number"/>

                <TextView
                    android:id="@+id/Faltantes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/rojo"
                    android:text="Faltante"
                    android:textColor="#FFFFFF"
                    android:padding="4dp"/>

                <EditText
                    android:id="@+id/txtFaltantes"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:inputType="number"/>

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/colorPrimary"
                    android:text="No Pertenece"
                    android:textColor="#FFFFFF"
                    android:padding="4dp"/>

                <EditText
                    android:id="@+id/txtSobrantes"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:inputType="number"/>
            </LinearLayout>
            
            <!-- Hidden inputs from original layout to prevent crash -->
            <EditText android:id="@+id/txtLeidos" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <EditText android:id="@+id/txtUbicacion" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>