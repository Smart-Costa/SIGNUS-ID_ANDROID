<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="16dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔍 Diagnóstico Lector RFID"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1A237E"
        android:layout_marginBottom="16dp"/>

    <!-- Reader selector removed, Zebra only -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lector Zebra Configurado"
        android:textStyle="bold"
        android:textColor="#333"
        android:layout_marginBottom="8dp"/>

    <!-- Selector de tipo de conexión -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tipo de Conexión:"
        android:textStyle="bold"
        android:textColor="#333"/>

    <RadioGroup
        android:id="@+id/rg_connection_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <RadioButton
            android:id="@+id/rb_auto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Auto"
            android:textColor="#333"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/rb_bluetooth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bluetooth"
            android:textColor="#333"/>

        <RadioButton
            android:id="@+id/rb_usb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="USB"
            android:textColor="#333"/>

        <RadioButton
            android:id="@+id/rb_serial"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Serial"
            android:textColor="#333"/>

    </RadioGroup>

    <!-- Panel de estado -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estado de Conexión"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#333"/>

            <TextView
                android:id="@+id/tv_connection_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● Desconectado"
                android:textColor="#F44336"
                android:textSize="14sp"
                android:paddingTop="4dp"/>

            <TextView
                android:id="@+id/tv_device_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dispositivo: —"
                android:textColor="#666"
                android:textSize="12sp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Botones de control de conexión -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btn_connect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Conectar"
            android:backgroundTint="#1565C0"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_disconnect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Desconectar"
            android:backgroundTint="#757575"
            android:enabled="false"
            android:layout_marginStart="4dp"/>

    </LinearLayout>

    <!-- Botones de inventario -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btn_start_inventory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="▶ Iniciar Scan"
            android:backgroundTint="#2E7D32"
            android:enabled="false"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_stop_inventory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="■ Detener Scan"
            android:backgroundTint="#B71C1C"
            android:enabled="false"
            android:layout_marginStart="4dp"/>

    </LinearLayout>

    <!-- Contador de tags -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tags detectados:"
            android:textStyle="bold"
            android:textColor="#333"/>

        <TextView
            android:id="@+id/tv_tag_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Limpiar"
            android:textSize="11sp"
            android:backgroundTint="#9E9E9E"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <!-- Lista de tags detectados -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_tag_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="— Esperando tags... —"
            android:textColor="#555"
            android:textSize="12sp"
            android:fontFamily="monospace"/>

    </ScrollView>

    <!-- Log de mensajes del sistema -->
    <TextView
        android:id="@+id/tv_system_log"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#1A237E"
        android:padding="8dp"
        android:textColor="#CFD8DC"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:gravity="bottom"
        android:text="Sistema listo."
        android:layout_marginTop="8dp"/>

    <!-- Botón continuar al Login (se habilita al conectar) -->
    <Button
        android:id="@+id/btn_continue_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Continuar al Login →"
        android:backgroundTint="#1B5E20"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="15sp"
        android:enabled="false"
        android:alpha="0.4"
        android:layout_marginTop="8dp"/>

</LinearLayout>
