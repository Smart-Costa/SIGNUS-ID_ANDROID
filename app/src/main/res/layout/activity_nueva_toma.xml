<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    tools:context=".UI.tomasfisicas.NuevaTomaActivity">

    <!-- 📌 Header Naranja -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FF5100"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@android:color/white"
            android:contentDescription="Atrás" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nueva Toma Física"
            android:gravity="center"
            android:textSize="20sp"
            android:textColor="@android:color/white"
            android:textStyle="bold" />
            
        <View
            android:layout_width="24dp"
            android:layout_height="24dp" />
    </LinearLayout>

    <!-- 📌 Título Conteos -->
    <TextView
        android:id="@+id/lblConteos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Conteos"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#606060"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 📌 Scroll Horizontal Tomas -->
    <HorizontalScrollView
        android:id="@+id/scrollTomas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/lblConteos">

        <LinearLayout
            android:id="@+id/containerTomasTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/btn_secondary_gray"
            android:padding="4dp">
            <!-- Items added dynamically or static placeholder -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toma 1"
                android:background="@drawable/btn_dark_gray"
                android:textColor="@android:color/white"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginEnd="8dp" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toma 2"
                android:background="@drawable/tab_unselected_bg"
                android:textColor="#666"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginEnd="8dp" />
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toma 3"
                android:background="@drawable/tab_unselected_bg"
                android:textColor="#666"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginEnd="8dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 📌 Tabs Resumen / Activos -->
    <LinearLayout
        android:id="@+id/tabsView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/scrollTomas">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tabResumen"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/btn_primary"
            android:text="Resumen"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:layout_marginEnd="4dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tabActivos"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/btn_secondary_gray"
            android:text="Activos"
            android:textColor="#666"
            android:textSize="14sp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- 📌 Contenedor Principal (Gauge o Lista) -->
    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tabsView"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="16dp">

        <!-- VISTA RESUMEN -->
        <LinearLayout
            android:id="@+id/viewResumen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/gaugeResumen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            app:indicatorSize="200dp"
                            app:trackThickness="20dp"
                            app:trackColor="#F0F0F0"
                            app:indicatorColor="#4DB6AC"
                            android:max="100"
                            android:progress="0" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtGaugeCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 de 0"
                                android:textSize="34sp"
                                android:textStyle="bold"
                                android:textColor="#333" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Activos"
                                android:textSize="16sp"
                                android:textColor="#666" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Botones Sobrante/Faltante -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp">

                        <!-- Botón Sobrantes (Izquierda) -->
                        <LinearLayout
                            android:id="@+id/btnSobrantesGauge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="8dp"
                            android:layout_marginEnd="24dp">

                            <TextView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/circle_yellow"
                                android:text="+"
                                android:textColor="@android:color/white"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:layout_marginEnd="8dp"/>

                            <TextView
                                android:id="@+id/txtSobrantesGauge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+0"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#333"/>
                        </LinearLayout>

                        <!-- Botón Faltantes (Derecha) -->
                        <LinearLayout
                            android:id="@+id/btnFaltantesGauge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="8dp"
                            android:layout_marginStart="24dp">

                            <TextView
                                android:id="@+id/txtFaltantesGauge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-0"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#333"
                                android:layout_marginEnd="8dp"/>

                            <TextView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/circle_red"
                                android:text="-"
                                android:textColor="@android:color/white"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:gravity="center"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lyFiltrosResumen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_bloque_tabla"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Filtros"
                            android:textStyle="bold"
                            android:textColor="#606060"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/txtCountActivosFiltrados"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Activos filtrados: 0"
                            android:textColor="#606060"
                            android:layout_marginBottom="12dp" />

                        <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Categoría"
                        android:textColor="#808080"
                        android:textSize="12sp"
                        android:layout_marginTop="0dp"/>
                    <Spinner
                        android:id="@+id/spinnerCategoria"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="4dp" />
                    <TextView
                        android:id="@+id/txtCountCategoria"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activos: 0"
                        android:textColor="#606060"
                        android:textSize="12sp" 
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ubicación A"
                        android:textColor="#808080"
                        android:textSize="12sp" />
                        <Spinner
                            android:id="@+id/spinnerUbicacionA"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:id="@+id/txtCountUbicacionA"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Activos: 0"
                            android:textColor="#606060"
                            android:textSize="12sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ubicación B"
                            android:textColor="#808080"
                            android:textSize="12sp" />
                        <Spinner
                            android:id="@+id/spinnerUbicacionB"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:id="@+id/txtCountUbicacionB"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Activos: 0"
                            android:textColor="#606060"
                            android:textSize="12sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ubicación C"
                            android:textColor="#808080"
                            android:textSize="12sp" />
                        <Spinner
                            android:id="@+id/spinnerUbicacionC"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:id="@+id/txtCountUbicacionC"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Activos: 0"
                            android:textColor="#606060"
                            android:textSize="12sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ubicación D"
                            android:textColor="#808080"
                            android:textSize="12sp" />
                        <Spinner
                            android:id="@+id/spinnerUbicacionD"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:id="@+id/txtCountUbicacionD"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Activos: 0"
                            android:textColor="#606060"
                            android:textSize="12sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ubicación Secundaria"
                            android:textColor="#808080"
                            android:textSize="12sp" />
                        <Spinner
                            android:id="@+id/spinnerUbicacionSecundaria"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:id="@+id/txtCountUbicacionSecundaria"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Activos: 0"
                            android:textColor="#606060"
                            android:textSize="12sp" />

                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- VISTA ACTIVOS -->
        <LinearLayout
            android:id="@+id/viewActivos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- SUMMARY CONTAINER -->
            <ScrollView
                android:id="@+id/scrollSummary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">

                <LinearLayout
                    android:id="@+id/llSummaryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Row Faltantes -->
                    <LinearLayout
                        android:id="@+id/rowFaltantes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/shape_circle"
                            app:tint="#D32F2F"
                            android:layout_marginEnd="16dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Faltantes"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333"/>

                        <TextView
                            android:id="@+id/txtFaltantesCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333"
                            android:layout_marginEnd="8dp"/>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="#757575"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0"/>

                    <!-- Row Encontrados -->
                    <LinearLayout
                        android:id="@+id/rowEncontrados"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/shape_circle"
                            app:tint="#388E3C"
                            android:layout_marginEnd="16dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Encontrados"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333"/>

                        <TextView
                            android:id="@+id/txtEncontradosCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333"
                            android:layout_marginEnd="8dp"/>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="#757575"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0"/>

                    <!-- Row Sobrantes -->
                    <LinearLayout
                        android:id="@+id/rowSobrantes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/shape_circle"
                            app:tint="#FBC02D"
                            android:layout_marginEnd="16dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sobrantes"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333"/>

                        <TextView
                            android:id="@+id/txtSobrantesCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333"
                            android:layout_marginEnd="8dp"/>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="#757575"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0"/>

                    <!-- Row No Inventariados (Pending) -->
                    <LinearLayout
                        android:id="@+id/rowNoInventariados"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/shape_circle"
                            app:tint="#9E9E9E"
                            android:layout_marginEnd="16dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Aún no inventariados"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333"/>

                        <TextView
                            android:id="@+id/txtNoInventariadosCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333"
                            android:layout_marginEnd="8dp"/>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="#757575"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0"/>

                </LinearLayout>
            </ScrollView>

            <!-- LIST CONTAINER (Initially GONE) -->
            <LinearLayout
                android:id="@+id/llListContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#EEEEEE"
                    android:padding="8dp"
                    android:orientation="horizontal">
                     <ImageView
                        android:id="@+id/btnBackToList"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="#666"
                        android:layout_marginEnd="8dp"/>
                     <TextView
                        android:id="@+id/txtListTitle"
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:text="Detalle"
                         android:textStyle="bold"
                         android:textColor="#666"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lyAgregarLecturaManual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_bloque_tabla"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Agregar Lectura Manual"
                        android:textStyle="bold"
                        android:textColor="#606060"
                        android:layout_marginBottom="8dp"/>

                    <CheckBox
                        android:id="@+id/chkIncluirExternos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cargar todos los activos"
                        android:textColor="#606060"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activo"
                        android:textColor="#808080"
                        android:textSize="12sp" />
                    <Spinner
                        android:id="@+id/spinnerActivos"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="12dp" />

                    <ProgressBar
                        android:id="@+id/progressCargaManual"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/txtSinDatosManual"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No se encontraron activos para esta ubicación"
                        android:gravity="center"
                        android:textColor="#D32F2F"
                        android:textStyle="italic"
                        android:padding="8dp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnAgregarLectura"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Agregar de la Lista"
                        android:background="@drawable/btn_primary"
                        android:textColor="@color/blanco"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginBottom="16dp"/>

                    <EditText
                        android:id="@+id/etManualInput"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Ingrese EPC o Placa"
                        android:background="@drawable/bg_bloque_tabla"
                        android:padding="8dp"
                        android:inputType="textCapCharacters"
                        android:layout_marginBottom="8dp"/>

                    <Button
                        android:id="@+id/btnManualAdd"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Añadir por Texto"
                        android:background="@drawable/btn_secondary_gray"
                        android:textColor="#333"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listScannedTags"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_activo_estado" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

    <!-- 📌 Bottom Navbar (Potencia, Iniciar, Subir) -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:background="#F5F5F5"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Potencia -->
        <LinearLayout
            android:id="@+id/btnPotencia"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">
            
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_settings"
                app:tint="#757575" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Potencia"
                android:textSize="12sp"
                android:textColor="#757575" />
        </LinearLayout>

        <!-- Iniciar (Central, destacado) -->
        <LinearLayout
            android:id="@+id/btnIniciar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/btn_primary"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_margin="4dp">
                
                <ImageView
                    android:id="@+id/iconIniciar"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_nfc" 
                    app:tint="@android:color/white" />
                <TextView
                    android:id="@+id/txtIniciar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Iniciar"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Subir -->
        <LinearLayout
            android:id="@+id/btnSubir"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">
            
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_upload"
                app:tint="#757575" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subir"
                android:textSize="12sp"
                android:textColor="#757575" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
