<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/blanco"
    tools:context=".UI.tomasfisicas.RegistroInventarioElectronicosActivity">

    <!-- 📌 Panel Superior -->
    <LinearLayout
        android:id="@+id/contenedorSuperior"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inventario de Electrónicos"
            android:textColor="#606060"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- 📌 Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTomas"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/btn_primary"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:text="Tomas"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeMaxTextSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <Button
                android:id="@+id/btnTomasCompletas"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_secondary_gray"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:text="Tomas Completas"
                android:textAllCaps="true"
                android:textColor="@color/nav_item_text_tint"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeMaxTextSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 📌 Cabecera -->
        <LinearLayout
            android:id="@+id/lyCabecera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:layout_marginTop="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Toma"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Fecha"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Estado"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- 📌 Recycler -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTomas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/contenedorSuperior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/kpiContainer" />

    <!-- 📌 KPI Gauge -->
    <FrameLayout
        android:id="@+id/kpiContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnNuevaToma">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/kpiProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:indicatorSize="140dp"
            app:trackThickness="12dp"
            app:trackColor="#E0E0E0"
            app:indicatorColor="@color/colorPrimary"
            android:max="100"
            android:progress="60" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/kpiValor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#333" />

            <TextView
                android:id="@+id/kpiTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="de 5"
                android:textSize="14sp"
                android:textColor="#666" />
        </LinearLayout>
    </FrameLayout>

    <!-- 📌 Botón Nueva Toma (FAB) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnNuevaToma"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"
        app:backgroundTint="@color/colorPrimary"
        app:srcCompat="@android:drawable/ic_input_add"
        app:tint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="Nueva Toma" />

</androidx.constraintlayout.widget.ConstraintLayout>
